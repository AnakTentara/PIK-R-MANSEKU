datasource db {
  provider = "sqlite"
  url      = "file:../local.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

model Candidate {
  id              String   @id @default(uuid())
  nisn            String   @unique
  name            String
  className       String
  whatsappNumber  String
  email           String
  gender          String
  asalSekolah     String   @default("-")
  reason          String
  status          String   @default("PENDING")
  photoPath       String?
  
  // Authentication fields for Member Login
  password        String?  // Hashed password
  plainPassword   String?  // Plaintext password for Admin export/view
  
  // Notification status
  emailNotified   Boolean  @default(false)
  waNotified      Boolean  @default(false)
  lastStatus      String   @default("PENDING")
  
  // Selection schedule fields
  selectionDate       DateTime?
  selectionDay        String?
  selectionNotified   Boolean  @default(false)
  attendanceStatus    String?  @default("BELUM_KONFIRMASI") // HADIR, TIDAK_HADIR, BELUM_KONFIRMASI

  selectionScore      SelectionScore?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SelectionScore {
  id              String    @id @default(uuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // POS 1: Wawancara dan Perkenalan
  pos1Evaluator      String?
  pos1Comm           Float?   // Komunikasi (1-10)
  pos1Trust          Float?   // Percaya Diri (1-10)
  pos1Motiv          Float?   // Motivasi (1-10)
  pos1Komitmen       Float?   // Komitmen (1-10)
  pos1KerjaSama      Float?   // Kerja Sama (1-10)
  pos1Kepemimpinan   Float?   // Kepemimpinan (1-10)
  pos1Pengetahuan    Float?   // Pengetahuan (1-10)
  pos1Etika          Float?   // Etika (1-10)
  pos1Bonus          Float?   // Bonus (1-10)
  pos1Avg            Float?   // Rata-rata POS 1
  pos1Completed      Boolean  @default(false)
  pos1Notes          String?

  // POS 2: Tes Minat Bakat
  pos2Evaluator   String?
  pos2Creativity  Float?   // Kreativitas (1-10)
  pos2Mastery     Float?   // Penguasaan (1-10)
  pos2Pres        Float?   // Presentasi (1-10)
  pos2Orig        Float?   // Orisinalitas (1-10)
  pos2Potency     Float?   // Potensi (1-10)
  pos2Confidence  Float?   // Percaya Diri (1-10)
  pos2Avg         Float?   // Rata-rata POS 2
  pos2Completed   Boolean  @default(false)
  pos2Notes       String?

  // POS 3: Studi Kasus
  pos3Evaluator      String?
  pos3Pemahaman      Float?   // Pemahaman (1-10)
  pos3Analysis       Float?   // Analisis (1-10)
  pos3Solution       Float?   // Solusi (1-10)
  pos3Empati         Float?   // Empati (1-10)
  pos3PublicSpk      Float?   // Public Speaking (1-10)
  pos3Logika         Float?   // Logika (1-10)
  pos3Pengetahuan    Float?   // Pengetahuan (1-10)
  pos3Avg            Float?   // Rata-rata POS 3
  pos3Completed      Boolean  @default(false)
  pos3Notes          String?

  // Total & Final Status
  finalScore      Float?   // Rata-rata 33.3% per POS: (pos1Avg + pos2Avg + pos3Avg) / 3
  isCompleted     Boolean  @default(false) // Overall lock status

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("KABINET_UMUM")
  posts     Post[]
  blogPosts BlogPost[] // Relation to BlogPost
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String
  authorId  String
  author    Admin     @relation(fields: [authorId], references: [id])
  views     Int       @default(0) // views count
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BlogPost {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  content      String
  category     String        @default("Umum")
  tags         String        @default("") // Comma-separated tags
  status       String        @default("DRAFT") // DRAFT | PUBLISHED
  featuredImg  String?
  views        Int           @default(0)
  authorId     String?       // FK to Admin (optional)
  memberId     String?       // FK to Member (optional)
  author       Admin?        @relation(fields: [authorId], references: [id])
  memberAuthor Member?       @relation(fields: [memberId], references: [id])
  comments     BlogComment[]
  likes        BlogLike[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model BlogComment {
  id        String        @id @default(uuid())
  postId    String
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String
  memberId  String?       // FK to Member (optional, if logged in)
  member    Member?       @relation(fields: [memberId], references: [id])
  username  String        // fallback for guest
  parentId  String?
  parent    BlogComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BlogComment[] @relation("CommentThread")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogLike {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String?  // Nullable for guest
  member    Member?  @relation(fields: [memberId], references: [id])
  guestId   String?  // string for guest
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Member {
  id              String   @id @default(uuid())
  nisn            String   @unique
  name            String
  className       String
  whatsappNumber  String
  email           String
  gender          String
  asalSekolah     String   @default("-")
  password        String
  plainPassword   String?
  status          String   @default("ACTIVE")
  joinYear        Int      @default(2026)
  role            String   @default("member")
  photoPath       String?
  bio             String?  // kata-kata / bio singkat di halaman biodata /@slug
  cardConfig      String?  // JSON: kustomisasi kartu biodata /@slug oleh anggota (cover, foto kartu, field tersembunyi, kartu info)
  memberCode      String?  @unique // kode ID Card, mis. PIKR_0001-26 (barcode depan)
  slug            String?  @unique // link profil /@slug (QR belakang ID Card)
  attendances     Attendance[]
  orgMember       OrgMember?  // back-relation
  blogPosts       BlogPost[]   // written posts
  blogComments    BlogComment[] // posted comments
  blogLikes       BlogLike[]   // likes
  following       Follow[]     @relation("Follower")   // akun yang saya ikuti
  followers       Follow[]     @relation("Following")  // akun yang mengikuti saya
  relationsOut    MemberRelation[] @relation("RelOwner")   // teman dekat / bisukan / blokir milik saya
  relationsIn     MemberRelation[] @relation("RelTarget")
  reportsMade     Report[]     @relation("Reporter")
  stories         Story[]
  // Ruang Cerita
  rcProfile        RcProfile?
  rcReqFrom        RcFollowRequest[]  @relation("RcReqFrom")
  rcReqTo          RcFollowRequest[]  @relation("RcReqTo")
  rcPosts          RcPost[]           @relation("RcPostAuthor")
  rcLikes          RcLike[]           @relation("RcLiker")
  rcSaves          RcSave[]           @relation("RcSaver")
  rcTagged         RcTag[]            @relation("RcTagged")
  rcComments       RcComment[]        @relation("RcCommenter")
  rcCommentLikes   RcCommentLike[]    @relation("RcCommentLiker")
  rcStories        RcStory[]          @relation("RcStoryAuthor")
  rcStoryViews     RcStoryView[]      @relation("RcStoryViewer")
  rcStoryReacts    RcStoryReaction[]  @relation("RcStoryReactor")
  rcHighlights     RcHighlight[]      @relation("RcHighlightOwner")
  rcThreads        RcThreadMember[]   @relation("RcThreadMember")
  rcMessages       RcMessage[]        @relation("RcSender")
  rcMsgReactions   RcMessageReaction[] @relation("RcMsgReactor")
  rcCounselAsked   RcCounselSession[] @relation("RcCounselStudent")
  rcCounselTaken   RcCounselSession[] @relation("RcCounselCounselor")
  rcCounselor      RcCounselor?       @relation("RcCounselorProfile")
  rcNotifs         RcNotification[]   @relation("RcNotifUser")
  rcNotifsActed    RcNotification[]   @relation("RcNotifActor")
  rcRestricts      RcRestrict[]       @relation("RcRestrictOwner")
  rcRestrictedBy   RcRestrict[]       @relation("RcRestrictTarget")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrgMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  jabatan     String
  yearStart   Int
  yearEnd     Int?
  isCurrent   Boolean  @default(false)
  photoPath   String?  // used only for orphan entries (no linked Member account)
  quote       String?
  memberId    String?  @unique // FK to Member (nullable)
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlumniTestimonial {
  id          String   @id @default(uuid())
  name        String
  angkatan    String
  photoPath   String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledAnnouncement {
  id            String    @id @default(uuid())
  title         String
  targetGroup   String    // e.g. 'GROUP_WA_CALON', 'GROUP_WA_PENGURUS', 'PERSONAL_WA', 'CUSTOM_JID'
  targetJid     String?   // e.g. '1203630123456789@g.us'
  targetName    String?   // e.g. 'Grup Calon Anggota PIK-R 2026'
  message       String
  mediaUrl      String?   // file path or URL for uploaded photo/video/doc
  mediaType     String?   // 'IMAGE', 'VIDEO', 'DOCUMENT', 'NONE'
  mediaName     String?   // Original filename
  scheduledAt   DateTime
  status        String    @default("SCHEDULED") // 'SCHEDULED', 'SENT', 'FAILED', 'CANCELLED'
  sentAt        DateTime?
  totalTarget   Int       @default(0)
  totalSent     Int       @default(0)
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WhatsAppGroup {
  id          String   @id @default(uuid())
  jid         String   @unique
  name        String
  memberCount Int      @default(0)
  lastMsgAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnnouncementLog {
  id             String   @id @default(uuid())
  announcementId String?
  sender         String?
  receiverJid    String?
  content        String
  type           String   @default("INFO") // 'INCOMING_MSG', 'OUTGOING_BROADCAST', 'DEBUG'
  createdAt      DateTime @default(now())
}

model PasswordResetOtp {
  id          String   @id @default(uuid())
  identifier  String   // NISN or WA number
  otpCode     String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isUsed, expiresAt])
  @@index([identifier])
}

// ─── Absensi (absen.pikr-manseku.my.id) ───────────────────────────────
model AttendanceSession {
  id          String       @id @default(uuid())
  date        String       @unique // YYYY-MM-DD (WIB, UTC+7)
  type        String       @default("WAJIB") // WAJIB (Alfa dihitung otomatis) | TAMBAHAN (Alfa diisi manual)
  title       String       @default("Kegiatan Rutin")
  description String?
  startTime   String?      // HH:mm, jam kegiatan wajib dari pengaturan
  openedBy    String
  records     Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String            // HADIR | SAKIT | IZIN | ALFA
  checkIn   DateTime?
  checkOut  DateTime?
  note      String?
  createdBy String
  updatedBy String?
  clientId  String?           @unique // id dari HP, mencegah data dobel saat kirim ulang offline
  logs      AttendanceLog[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, memberId])
}

model AttendanceLog {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  action       String     // IN | OUT | SAKIT | IZIN | ALFA | EDIT
  detail       String?
  by           String
  createdAt    DateTime   @default(now())
}

// ─── Sosial: ikuti, teman dekat, bisukan, blokir, laporan ─────────────────────
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    Member   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Member   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Hubungan pribadi satu arah. type: CLOSE_FRIEND | MUTE | BLOCK (tidak terlihat oleh target)
model MemberRelation {
  id        String   @id @default(uuid())
  ownerId   String
  owner     Member   @relation("RelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Member   @relation("RelTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId, type])
  @@index([targetId, type])
}

// Laporan pengguna, ditinjau admin. targetType: MEMBER | POST | COMMENT
model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    Member   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String
  targetId    String
  reason      String
  note        String?
  status      String   @default("OPEN") // OPEN | REVIEWED | DISMISSED
  createdAt   DateTime @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status])
}

// Cerita 24 jam ala Instagram untuk anggota PIK-R
model Story {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mediaUrl  String?
  caption   String?
  bgColor   String?  @default("#EA580C")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([memberId])
  @@index([expiresAt])
}

// ════════════════════════════════════════════════════════════════════════════
// RUANG CERITA — media sosial anggota PIK-R (API /api/rc/*)
// Akun = Member. Blog situs utama (BlogPost) tidak diubah.
// ════════════════════════════════════════════════════════════════════════════

// Pengaturan akun Ruang Cerita (1 per anggota, dibuat saat pertama dibuka)
model RcProfile {
  memberId      String   @id
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  isPrivate     Boolean  @default(true)   // akun remaja: privat bawaan (pengikut harus disetujui)
  dmPolicy      String   @default("FOLLOWING") // EVERYONE | FOLLOWING | NONE
  showActivity  Boolean  @default(true)   // status "aktif" dan tanda dibaca
  hiddenWords   String   @default("")     // kata yang disembunyikan dari komentar & pesan (dipisah koma)
  quietStart    String?                    // mode tenang "22:00"
  quietEnd      String?                    // "06:00"
  note          String?                    // catatan singkat di atas inbox (Notes), 60 karakter
  noteAt        DateTime?
  frozenUntil   DateTime?                  // dibekukan moderator (akun anggota tetap aktif)
  frozenReason  String?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Permintaan mengikuti akun privat
model RcFollowRequest {
  id          String   @id @default(uuid())
  requesterId String
  requester   Member   @relation("RcReqFrom", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      Member   @relation("RcReqTo", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([requesterId, targetId])
  @@index([targetId])
}

model RcPost {
  id            String   @id @default(uuid())
  authorId      String
  author        Member   @relation("RcPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  caption       String   @default("")
  audience      String   @default("FOLLOWERS") // FOLLOWERS | CLOSE_FRIENDS (akun publik: FOLLOWERS = semua anggota)
  commentsOff   Boolean  @default(false)
  hideLikes     Boolean  @default(false)
  pinned        Boolean  @default(false)
  removedAt     DateTime?                // dihapus moderator (tidak tampil)
  editedAt      DateTime?
  media         RcMedia[]
  likes         RcLike[]
  comments      RcComment[]
  saves         RcSave[]
  tags          RcTag[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model RcMedia {
  id        String  @id @default(uuid())
  postId    String
  post      RcPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      String  @default("IMAGE") // IMAGE | VIDEO
  url       String                     // /uploads/rc/...
  thumbUrl  String?                    // gambar kecil untuk grid
  width     Int     @default(1080)
  height    Int     @default(1350)
  alt       String?
  order     Int     @default(0)

  @@index([postId])
}

model RcLike {
  postId    String
  post      RcPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation("RcLiker", fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, memberId])
  @@index([memberId])
}

model RcSave {
  postId    String
  post      RcPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation("RcSaver", fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, memberId])
  @@index([memberId, createdAt])
}

// Penandaan anggota di postingan
model RcTag {
  postId    String
  post      RcPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation("RcTagged", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([postId, memberId])
  @@index([memberId])
}

model RcComment {
  id         String   @id @default(uuid())
  postId     String
  post       RcPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     Member   @relation("RcCommenter", fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     RcComment? @relation("RcThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    RcComment[] @relation("RcThread")
  content    String
  pinned     Boolean  @default(false)
  hidden     Boolean  @default(false) // kata tersembunyi / disembunyikan pemilik postingan
  likes      RcCommentLike[]
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}

model RcCommentLike {
  commentId String
  comment   RcComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation("RcCommentLiker", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([commentId, memberId])
}

// Cerita 24 jam
model RcStory {
  id         String   @id @default(uuid())
  authorId   String
  author     Member   @relation("RcStoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  kind       String   @default("IMAGE") // IMAGE | VIDEO | TEXT
  url        String?
  text       String?
  bg         String?                     // latar cerita teks
  audience   String   @default("FOLLOWERS") // FOLLOWERS | CLOSE_FRIENDS
  sticker    String?                     // JSON stiker interaktif: { type:'poll'|'question', q, options[] }
  removedAt  DateTime?
  expiresAt  DateTime
  views      RcStoryView[]
  reactions  RcStoryReaction[]
  highlights RcHighlightItem[]
  createdAt  DateTime @default(now())

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model RcStoryView {
  storyId   String
  story     RcStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Member   @relation("RcStoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  answer    String?                      // jawaban polling/pertanyaan
  createdAt DateTime @default(now())

  @@id([storyId, viewerId])
}

model RcStoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  story     RcStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation("RcStoryReactor", fields: [memberId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([storyId, memberId])
}

// Sorotan di profil (cerita yang disimpan permanen)
model RcHighlight {
  id        String   @id @default(uuid())
  ownerId   String
  owner     Member   @relation("RcHighlightOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  coverUrl  String?
  order     Int      @default(0)
  items     RcHighlightItem[]
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model RcHighlightItem {
  highlightId String
  highlight   RcHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  storyId     String
  story       RcStory     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order       Int         @default(0)

  @@id([highlightId, storyId])
}

// ─── Pesan (DM) ─────────────────────────────────────────────────────────────
model RcThread {
  id            String   @id @default(uuid())
  isGroup       Boolean  @default(false)
  title         String?
  createdById   String
  lastMessageAt DateTime @default(now())
  members       RcThreadMember[]
  messages      RcMessage[]
  createdAt     DateTime @default(now())

  @@index([lastMessageAt])
}

model RcThreadMember {
  threadId   String
  thread     RcThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation("RcThreadMember", fields: [memberId], references: [id], onDelete: Cascade)
  status     String   @default("ACCEPTED") // ACCEPTED | REQUEST (permintaan pesan) | LEFT
  isAdmin    Boolean  @default(false)
  muted      Boolean  @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime @default(now())

  @@id([threadId, memberId])
  @@index([memberId, status])
}

model RcMessage {
  id         String   @id @default(uuid())
  threadId   String
  thread     RcThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  sender     Member   @relation("RcSender", fields: [senderId], references: [id], onDelete: Cascade)
  kind       String   @default("TEXT") // TEXT | IMAGE | POST | STORY_REPLY | SYSTEM
  text       String?
  url        String?
  refId      String?                  // postingan / cerita yang dibagikan atau dibalas
  replyToId  String?
  viewOnce   Boolean  @default(false)
  openedAt   DateTime?                // foto sekali lihat sudah dibuka
  editedAt   DateTime?
  unsentAt   DateTime?                // ditarik
  reactions  RcMessageReaction[]
  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
}

model RcMessageReaction {
  messageId String
  message   RcMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation("RcMsgReactor", fields: [memberId], references: [id], onDelete: Cascade)
  emoji     String

  @@id([messageId, memberId])
}

// ─── Bilik Konseling ────────────────────────────────────────────────────────
// Berbeda dari DM: siswa membuka sesi (boleh anonim bagi konselor), konselor piket mengambil sesi.
model RcCounselSession {
  id           String   @id @default(uuid())
  studentId    String
  student      Member   @relation("RcCounselStudent", fields: [studentId], references: [id], onDelete: Cascade)
  counselorId  String?
  counselor    Member?  @relation("RcCounselCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  alias        String                     // nama samaran yang dilihat konselor bila anonim
  anonymous    Boolean  @default(true)
  topic        String   @default("LAINNYA") // PERTEMANAN | KELUARGA | BELAJAR | PERASAAN | KESEHATAN_REPRODUKSI | PERUNDUNGAN | LAINNYA
  status       String   @default("WAITING") // WAITING | ACTIVE | CLOSED
  urgent       Boolean  @default(false)     // terdeteksi kata darurat
  escalatedAt  DateTime?                    // diteruskan ke pembina/BK
  rating       Int?
  messages     RcCounselMessage[]
  lastAt       DateTime @default(now())
  closedAt     DateTime?
  createdAt    DateTime @default(now())

  @@index([status, lastAt])
  @@index([studentId])
  @@index([counselorId])
}

model RcCounselMessage {
  id         String   @id @default(uuid())
  sessionId  String
  session    RcCounselSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromRole   String   // STUDENT | COUNSELOR | SYSTEM
  senderId   String?
  text       String
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Konselor sebaya yang bertugas (diatur dari dashboard)
model RcCounselor {
  memberId  String   @id
  member    Member   @relation("RcCounselorProfile", fields: [memberId], references: [id], onDelete: Cascade)
  days      String   @default("1,2,3,4,5") // hari piket 0=Minggu..6
  active    Boolean  @default(true)
  bio       String?
  createdAt DateTime @default(now())
}

// ─── Notifikasi ─────────────────────────────────────────────────────────────
model RcNotification {
  id         String   @id @default(uuid())
  userId     String
  user       Member   @relation("RcNotifUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      Member?  @relation("RcNotifActor", fields: [actorId], references: [id], onDelete: Cascade)
  type       String   // LIKE | COMMENT | REPLY | FOLLOW | FOLLOW_REQUEST | FOLLOW_ACCEPT | MENTION | TAG | STORY_REACT | COUNSEL
  postId     String?
  commentId  String?
  text       String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// Akun yang dibatasi (Restrict): komentarnya hanya terlihat oleh dirinya sendiri, pesan masuk ke permintaan
model RcRestrict {
  ownerId   String
  owner     Member  @relation("RcRestrictOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Member  @relation("RcRestrictTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ownerId, targetId])
}
