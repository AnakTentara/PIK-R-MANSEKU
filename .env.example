# Salin menjadi .env lalu isi. Jangan pernah meng-commit .env.

PORT=25552
NODE_ENV=production

# Teks acak minimal 24 karakter. Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Server produksi menolak berjalan bila kosong atau memakai nilai bawaan lama.
JWT_SECRET=

# Alamat situs. Link QR ID Card, email, WhatsApp, sitemap, dan CORS turun dari sini.
# Pindah domain / server = ubah baris ini saja.
PUBLIC_SITE_URL="https://pikr-manseku.my.id"
FRONTEND_URL="https://pikr-manseku.my.id"
# Opsional, bawaan: https://absen.<domain> dan https://d-base.<domain>
# ABSEN_SITE_URL=
# API_SITE_URL=
# Origin tambahan (dipisah koma), mis. alamat LAN untuk tes dari HP
# CORS_ORIGINS=

# Hanya untuk komputer uji yang BUKAN server utama (mencegah dua bot WhatsApp login bersamaan)
# DISABLE_WHATSAPP=1

# Cadangan harian (scripts/backup.mjs)
# BACKUP_DIR=D:\PIK-R-BACKUP
# BACKUP_KEEP=14

# Email (pengumuman kelulusan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
