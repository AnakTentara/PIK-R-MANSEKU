# ==============================================================================
# .gitignore — Monorepo PIK-R MANSEKU SaaS
# ==============================================================================

# ── Dependencies ──
node_modules/
**/node_modules/
.pnpm-store/

# ── Environment & Secrets (JANGAN PERNAH KE GITHUB) ──
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!**/.env.production.example
config.json
**/firebase-service-account*.json
**/google-services.json
**/GoogleService-Info.plist

# ── WhatsApp Baileys Auth & Sesi Percakapan ──
.baileys_auth/
baileys_store.json
.curhat_sessions/
**/.baileys_auth/
**/.curhat_sessions/

# ── Temporary, Scratch & Log Files ──
scratch/
**/scratch/
*.tmp
*.tmp*
*.bak
*.log
npm-debug.log*
yarn-debug.log*

# ── Database & SQLite Files ──
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3
local.db*
**/local.db*

# ── Backup Files & Arsip Berat (Data Pribadi Siswa) ──
PIK-R-BACKUP/
OrganizationOS/
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.gz

# ── Flutter / Dart Build Outputs & Cache ──
pikr_app/build/
pikr_app/.dart_tool/
pikr_app/.flutter-plugins
pikr_app/.flutter-plugins-dependencies
pikr_app/.pub-cache/
pikr_app/.pub/
**/build/
**/.dart_tool/
android/.gradle/
.gradle/
**/.gradle/

# ── Web Build Outputs ──
dist/
**/dist/

# ── Excel & Data Spreadsheet Pribadi Siswa ──
*.xlsx
*.xls
*.csv
!PIK-R-MANSEKU/public/file/**/*.xlsx
!PIK-R-MANSEKU/public/file/**/*.xls

# ── Absensi & ID Card Heavy Files ──
PIK-R-ABSEN/.restore/
PIK-R-ABSEN/.tools/
PIK-R-ABSEN/.sandbox/
PIK-R-ABSEN/Gelombang */
PIK-R-ABSEN/ID CARD PIK-R OK/
PIK-R-ABSEN/Id card pik-r manseku*/
PIK-R-ABSEN/idcard_scan.json
PIK-R-ABSEN/data_anggota.*
PIK-R-ABSEN/failed-list.xlsx

# ── Foto Pribadi yang Diunggah Anggota & Foto Pesan Terenkripsi ──
